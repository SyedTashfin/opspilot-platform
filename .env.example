# Copy to .env and fill in. Never commit .env.
OPSPILOT_ENVIRONMENT=local
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot

# Model gateway (M2). Provider keys are read by LiteLLM from the standard env vars.
OPSPILOT_DEFAULT_MODEL=deepseek/deepseek-chat
OPSPILOT_FALLBACK_MODEL=mistral/mistral-small-latest
OPSPILOT_DAILY_COST_CAP_EUR=2.0
OPSPILOT_RUN_COST_CAP_EUR=0.25
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Observability (M5)
OPSPILOT_OTEL_EXPORTER_OTLP_ENDPOINT=
